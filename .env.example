# --- Server ---
PORT=3333
NODE_ENV=development

# --- Database ---
MONGODB_URI=
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# --- Auth (JWT) ---
# Required on Cloudflare Workers. Use long random values; never reuse them across environments.
JWT_SECRET=
REFRESH_TOKEN_SECRET=
JWT_EXPIRES_IN=7d

# --- Notifications ---
# Set the same ISO UTC rollout cutoff on every instance to enable the in-app notification worker.
# NOTIFICATIONS_START_AT=2026-11-20T00:00:00.000Z

# --- Seed ---
# Chi dung voi CLI seed: cap nhat quyen role da co, khong insert; startup khong sync quyen
SEED_SYNC_ROLE_PERMISSIONS=false

# --- Email (account creation and forgot password) ---
# MAIL_TRANSPORT=console prints mail to the log: development only.
# SMTP_SECURE=true forces TLS; port 465 always uses implicit TLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
APP_URL=http://localhost:5173
# MAIL_TRANSPORT=console

# --- Maintenance scripts only (scripts/*.mjs) ---
# deploy-reviewed-db.mjs / add-product-categories.mjs --atlas
# MONGODB_SOURCE_URI=
# MONGODB_TARGET_URI=
# reset-test-user-password.mjs (8+ characters, at most 72 UTF-8 bytes)
# WMSD_TEST_NEW_PASSWORD=
# start-fe06-thunder.mjs
# FE06_TEST_PORT=3016
# FE06_TEST_MONGO_URI=

# --- Background jobs (23/11/2026, see git_doc/docs/08_api/SYSTEM_ADMIN.md) ---
# Notification emails are sent whenever mail is configured above; set to off to disable them.
# NOTIFICATION_EMAIL=off
# Minutes between low-stock scans (default 15).
# LOW_STOCK_SCAN_MINUTES=15
