PORT=3333
# Set the same ISO UTC rollout cutoff on every instance to enable the in-app notification worker.
# NOTIFICATIONS_START_AT=2026-11-20T00:00:00.000Z
MONGODB_URI=
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# Chi dung voi CLI seed: cap nhat quyen role da co, khong insert; startup khong sync quyen
SEED_SYNC_ROLE_PERMISSIONS=false

# Email (account creation and forgot password). MAIL_TRANSPORT=console prints mail to the log: development only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
APP_URL=http://localhost:5173
# MAIL_TRANSPORT=console
