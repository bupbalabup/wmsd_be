{
  "name": "wmsd-be",
  "main": "src/worker.js",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "vars": {
    "NODE_ENV": "production",
    "APP_URL": "https://wmsd.tanthuong.workers.dev"
  },
  "durable_objects": {
    "bindings": [{ "name": "BACKEND", "class_name": "Backend" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Backend"] }],
  "triggers": { "crons": ["* * * * *"] }
}
