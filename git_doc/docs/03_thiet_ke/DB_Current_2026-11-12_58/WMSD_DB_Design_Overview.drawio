e="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#548235;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=4;fontSize=11;fontFamily=Arial;" vertex="1" parent="g_I"><mxGeometry x="320" y="448" width="270" height="268" as="geometry"/></mxCell><mxCell id="t_opening_stocks" value="&lt;div style=&quot;text-align:center;font-size:13px&quot;&gt;&lt;b&gt;opening_stocks&lt;/b&gt;&lt;/div&gt;&lt;hr style=&quot;margin:3px 0&quot;/&gt;&lt;b&gt;PK&lt;/b&gt; _id : DocID&lt;br/&gt;&lt;font color=&quot;#1F4E79&quot;&gt;&lt;b&gt;FK&lt;/b&gt; header.warehouseId → warehouses&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#1F4E79&quot;&gt;&lt;b&gt;FK&lt;/b&gt; header.preparedBy → users&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#1F4E79&quot;&gt;&lt;b&gt;FK&lt;/b&gt; stockTransactionId → stock_transactions&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#1F4E79&quot;&gt;&lt;b&gt;FK&lt;/b&gt; items[].productId → products&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#1F4E79&quot;&gt;&lt;b&gt;FK&lt;/b&gt; items[].lotId → product_batches&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#1F4E79&quot;&gt;&lt;b&gt;FK&lt;/b&gt; items[].locationId → warehouse_locations&lt;/font&gt;&lt;br/&gt;• documentNo : String&lt;br/&gt;• documentKind : String&lt;br/&gt;• workflowStatus : String&lt;br/&gt;• version : Number&lt;br/&gt;&lt;font color=&quot;#7F6000&quot;&gt;&lt;i&gt;⊂ sources[], items[]&lt;/i&gt;&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#888888&quot;&gt;&lt;i&gt;104 trường (kể cả lồng)&lt;/i&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#548235;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=4;fontSize=11;fontFamily=Arial;" vertex="1" parent="g_I"><mxGeometry x="20" y="490" width="270" height="252" as="geometry"/></mxCell><mxCell id="t_stock_reversals" value="&lt;div style=&quot;text-align:center;font-size:13px&quot;&gt;&lt;b&gt;stock_reversals&lt;/b&gt;&lt;/div&gt;&lt;hr style=&quot;margin:3px 0&quot;/&gt;&lt;b&gt;PK&lt;/b&gt; _id : DocID&lt;br/&gt;&lt;font color=&quot;#1F4E79&quot;&gt;&lt;b&gt;FK&lt;/b&gt; header.originalTransactionId → stock_transactions&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#1F4E79&quot;&gt;&lt;b&gt;FK&lt;/b&gt; header.requestedBy → users&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#1F4E79&quot;&gt;&lt;b&gt;FK&lt;/b&gt; items[].productId → products&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#1F4E79&quot;&gt;&lt;b&gt;FK&lt;/b&gt; items[].lotId → product_batches&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#1F4E79&quot;&gt;&lt;b&gt;FK&lt;/b&gt; approvalDecision.decisionId → approval_history&lt;/font&gt;&lt;br/&gt;• documentNo : String&lt;br/&gt;• documentKind : String&lt;br/&gt;• workflowStatus : String&lt;br/&gt;• version : Number&lt;br/&gt;&lt;font color=&quot;#7F6000&quot;&gt;&lt;i&gt;⊂ sources[], items[]&lt;/i&gt;&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#888888&quot;&gt;&lt;i&gt;109 trường (kể cả lồng)&lt;/i&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#548235;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=4;fontSize=11;fontFamily=Arial;" vertex="1" parent="g_I"><mxGeometry x="620" y="490" width="270" height="268" as="geometry"/></mxCell><mxCell id="title" value="&lt;b&gt;WMSD — Thiết kế cơ sở dữ liệu (MongoDB, 59 collection)&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:13px&quot;&gt;Sinh từ schema.json hiện hành (src/models) · ngày 22/11/2026 · Chứng từ có header{} + items[] nhúng, _id = mã phiếu (DocID)&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=24;fontFamily=Arial;fontColor=#17324D;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1600" height="70" as="geometry"/></mxCell><mxCell id="legend" value="&lt;b&gt;Chú giải&lt;/b&gt;&lt;br/&gt;&lt;b&gt;PK&lt;/b&gt; khoá chính · &lt;font color=&quot;#1F4E79&quot;&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; tham chiếu ref (logic, Mongo không kiểm FK)&lt;br/&gt;• bắt buộc · ○ tuỳ chọn · &lt;font color=&quot;#7F6000&quot;&gt;&lt;i&gt;⊂ x[]&lt;/i&gt;&lt;/font&gt; mảng tài liệu nhúng (không phải collection)&lt;br/&gt;&lt;font color=&quot;#5B6B7F&quot;&gt;──&lt;b&gt;‹&lt;/b&gt;&lt;/font&gt; quan hệ 1–n theo ref (cha → con)&lt;br/&gt;&lt;font color=&quot;#C00000&quot;&gt;- - ▶&lt;/font&gt; luồng chứng từ nguồn → chứng từ sau (DocID / sources[])&lt;br/&gt;&lt;b&gt;Không vẽ để tránh rối:&lt;/b&gt; mọi chứng từ nghiệp vụ (nhóm D–I) đều tham chiếu&lt;br/&gt;users (createdBy/…By), warehouses (header.warehouseId), products + product_batches (items[]),&lt;br/&gt;stock_transactions (stockTransactionId), inventory_balances, warehouse_locations,&lt;br/&gt;approval_history, operation_records, attachments (evidenceIds)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#17324D;align=left;verticalAlign=top;spacing=10;fontSize=12;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1700" y="10" width="900" height="165" as="geometry"/></mxCell><mxCell id="e_0" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=ERmany;startArrow=ERmandOne;endFill=0;startFill=0;strokeColor=#5B6B7F;strokeWidth=1.2;" edge="1" parent="1" source="t_products" target="t_conversions"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=ERmany;startArrow=ERmandOne;endFill=0;startFill=0;strokeColor=#5B6B7F;strokeWidth=1.2;" edge="1" parent="1" source="t_product_batches" target="t_conversions"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=ERmany;startArrow=ERmandOne;endFill=0;startFill=0;strokeColor=#5B6B7F;strokeWidth=1.2;" edge="1" parent="1" source="t_uoms" target="t_conversions"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=ERmany;startArrow=ERmandOne;endFill=0;startFill=0;stro