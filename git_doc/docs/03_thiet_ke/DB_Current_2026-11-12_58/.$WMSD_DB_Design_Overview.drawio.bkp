      <mxCell id="tra-hang-source-note" value="Một phiếu khách trả có thể tham chiếu nhiều phiếu xuất của cùng một đơn bán, cùng kho xử lý và cùng chế độ tiếp nhận. Nhánh xuất độc lập và nhánh chứng từ ngoài đã xác minh đều dùng một chứng từ nguồn. Mỗi dòng lưu chứng từ và dòng nguồn trong items[].sources[]." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#17263A;spacing=0;" vertex="1" parent="1"><mxGeometry x="44" y="38" width="880" height="40" as="geometry"/></mxCell>
